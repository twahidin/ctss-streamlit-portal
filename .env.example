# GitHub personal access token with `repo` write scope
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Mono-repo that holds the seven group folders
GITHUB_REPO=ctss/ctss-streamlit-projects

# JSON map: code -> { id, url, name }
# Generate codes with: python -c "import secrets; print(secrets.token_urlsafe(8))"
# Keep these secret — anyone with a code can overwrite that group's app.
GROUP_CODES={"sky-tiger-42":{"id":"group-1","url":"https://group-1.up.railway.app","name":"Group 1"},"red-otter-77":{"id":"group-2","url":"https://group-2.up.railway.app","name":"Group 2"}}
